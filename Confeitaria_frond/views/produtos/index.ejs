<%- include('../partials/header') %>

<div class="page-header">
  <h2>Produtos</h2>
  <a href="/produtos/novo" class="btn-primary">+ Novo produto</a>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Categoria</th>
      <th>Preço</th>
      <th>Estoque</th>
      <th>&nbsp;</th>
    </tr>
  </thead>
  <tbody>
    <% if (lista.length === 0) { %>
      <tr><td colspan="6" style="padding: 10px;">Nenhum produto cadastrado.</td></tr>
    <% } %>
    
    <% lista.forEach(p => { %>
      <tr style="border-bottom: 1px solid #eee;">
        <td><%= p.produtoId %></td>
        <td><%= p.produtoNome %></td>
        <td><%= mapaCat[p.categoriaId] || ('#' + p.categoriaId) %></td>
        <td>R$ <%= Number(p.produtoPreco).toFixed(2).replace('.', ',') %></td>
        <td><%= p.produtoEstoque %></td>
        
        <td>
          <div class="acoes">
            <a href="/produtos/editar/<%= p.produtoId %>" class="btn-editar">Editar</a>
            
            <form method="POST" action="/produtos/excluir/<%= p.produtoId %>" onsubmit="return confirm('Excluir o produto <%= p.produtoNome %>?');" style="margin: 0;">
              <button type="submit" class="btn-excluir">Excluir</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>