<%- include('../partials/header') %>

<div style="max-width: 1100px; margin: 0 auto;">
  <h2><%= item ? 'Editar pedido' : 'Novo pedido' %></h2>

  <form method="POST" action="<%= item ? '/pedidos/editar/' + item.pedidoId : '/pedidos/novo' %>" class="card-form">
    
    <label for="clienteId">Cliente *</label>
    <select id="clienteId" name="clienteId" required>
      <option value="">— selecione —</option>
      <% clientes.forEach(c => { %>
        <option value="<%= c.clienteId %>" <%= item && item.clienteId === c.clienteId ? 'selected' : '' %>>
          <%= c.clienteNome %>
        </option>
      <% }) %>
    </select>

    <label for="pedidoData">Data do Pedido *</label>
    <input type="datetime-local" id="pedidoData" name="pedidoData" required 
           value="<%= item ? new Date(item.pedidoData).toISOString().slice(0, 16) : new Date().toISOString().slice(0, 16) %>">

    <label for="pedidoStatus">Status *</label>
    <select id="pedidoStatus" name="pedidoStatus" required>
      <option value="">— selecione —</option>
      <option value="Aberto" <%= item && item.pedidoStatus === 'Aberto' ? 'selected' : '' %>>Aberto</option>
      <option value="Pago" <%= item && item.pedidoStatus === 'Pago' ? 'selected' : '' %>>Pago</option>
      <option value="Entregue" <%= item && item.pedidoStatus === 'Entregue' ? 'selected' : '' %>>Entregue</option>
    </select>

    <div class="form-buttons">
      <button type="submit" class="btn-salvar">Salvar</button>
      <a href="/pedidos" class="btn-cancelar">Cancelar</a>
    </div>
    
  </form>
</div>

<%- include('../partials/footer') %>