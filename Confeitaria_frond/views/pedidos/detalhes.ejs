<%- include('../partials/header') %>

<h2>Pedido #<%= pedido.pedidoId %> — Detalhes</h2>

<!-- Card de Dados do Pedido -->
<div class="card-detalhe">
  <h3>Dados do pedido</h3>
  <p><strong>Cliente:</strong> <%= nomeCliente %></p>
  <p><strong>Data:</strong> <%= new Date(pedido.pedidoData).toLocaleString('pt-BR') %></p>
  <p><strong>Status:</strong> <%= pedido.pedidoStatus %></p>
</div>

<!-- Card de Itens do Pedido -->
<div class="card-detalhe">
  <h3>Itens do pedido</h3>

  <% if (itensDoPedido.length === 0) { %>
    <p>Nenhum item vinculado.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Produto</th>
          <th>Qtd.</th>
          <th>Preço Unit.</th>
          <th>Subtotal</th>
          <th></th> <!-- Coluna de Ação sem título -->
        </tr>
      </thead>
      <tbody>
        <% let total = 0; %>
        <% itensDoPedido.forEach(i => {
             const sub = i.itemPedidoQuantidade * Number(i.itemPedidoPrecoUnitario);
             total += sub;
        %>
          <tr>
            <td><%= mapaProd[i.produtoId] || ('#' + i.produtoId) %></td>
            <td><%= i.itemPedidoQuantidade %></td>
            <td>R$ <%= Number(i.itemPedidoPrecoUnitario).toFixed(2).replace('.', ',') %></td>
            <td>R$ <%= sub.toFixed(2).replace('.', ',') %></td>
            <td>
              <div class="acoes">
                <form method="POST" action="/pedidos/detalhes/<%= pedido.pedidoId %>/itens/<%= i.produtoId %>/excluir" onsubmit="return confirm('Remover este item?');" style="margin: 0;">
                  <button type="submit" class="btn-excluir">Remover</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p style="margin-top: 16px; font-size: 16px;"><strong>Total:</strong> R$ <%= total.toFixed(2).replace('.', ',') %></p>
  <% } %>
</div>

<!-- Card de Adicionar Item -->
<div class="card-detalhe">
  <h3>+ Adicionar item</h3>
  
  <% if (produtosDisponiveis.length === 0) { %>
    <p>Todos os produtos já estão vinculados a este pedido.</p>
  <% } else { %>
    <form method="POST" action="/pedidos/detalhes/<%= pedido.pedidoId %>/itens" style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;">
      <div>
        <label for="produtoId" style="font-weight: bold; display: block; margin-bottom: 4px;">Produto</label>
        <select id="produtoId" name="produtoId" required style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; min-width: 200px;">
          <option value="">— selecione —</option>
          <% produtosDisponiveis.forEach(p => { %>
            <option value="<%= p.produtoId %>"><%= p.produtoNome %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="itemPedidoQuantidade" style="font-weight: bold; display: block; margin-bottom: 4px;">Qtd.</label>
        <input type="number" id="itemPedidoQuantidade" name="itemPedidoQuantidade" min="1" required value="1" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 80px;">
      </div>
      <div>
        <label for="itemPedidoPrecoUnitario" style="font-weight: bold; display: block; margin-bottom: 4px;">Preço Unit.</label>
        <input type="number" id="itemPedidoPrecoUnitario" name="itemPedidoPrecoUnitario" step="0.01" min="0" required readonly style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 120px; background-color: #f5f5f5;">
      </div>
      <div>
        <button type="submit" class="btn-detalhes">+ Adicionar</button>
      </div>
    </form>
  <% } %>
</div>

<a href="/pedidos" class="btn-cancelar" style="margin-top: 10px; display: inline-block;">← Voltar aos pedidos</a>

<!-- SCRIPT ÚNICO PARA PREENCHER O PREÇO AUTOMATICAMENTE -->
<script>
  const produtosDisponiveis = <%- JSON.stringify(produtosDisponiveis) %>;
  
  const precos = {};
  produtosDisponiveis.forEach(p => {
    precos[p.produtoId] = Number(p.produtoPreco).toFixed(2);
  });

  const selectProduto = document.getElementById('produtoId');
  if (selectProduto) {
    selectProduto.addEventListener('change', function() {
      const inputPreco = document.getElementById('itemPedidoPrecoUnitario');
      if (precos[this.value]) {
        inputPreco.value = precos[this.value];
      } else {
        inputPreco.value = '';
      }
    });
  }
</script>

<%- include('../partials/footer') %>