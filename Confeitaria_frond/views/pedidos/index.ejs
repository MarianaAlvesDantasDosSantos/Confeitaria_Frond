<%- include('../partials/header') %>

<div class="page-header">
  <h2>Pedidos</h2>
  <a href="/pedidos/novo" class="btn-primary">+ Novo pedido</a>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Cliente</th>
      <th>Data</th>
      <th>Status</th>
      <th>&nbsp;</th>
    </tr>
  </thead>
  <tbody>
    <% if (lista.length === 0) { %>
      <tr><td colspan="5" style="padding: 10px;">Nenhum pedido cadastrado.</td></tr>
    <% } %>
    
    <% lista.forEach(p => { %>
      <tr style="border-bottom: 1px solid #eee;">
        <td><%= p.pedidoId %></td>
        <td><%= mapaCli[p.clienteId] || ('#' + p.clienteId) %></td>
        <td><%= new Date(p.pedidoData).toLocaleString('pt-BR') %></td>
        <td><%= p.pedidoStatus %></td>
        
        <td>
          <div class="acoes">
          <a href="/pedidos/detalhes/<%= p.pedidoId %>" class="btn-detalhes">Detalhes</a>
            <a href="/pedidos/editar/<%= p.pedidoId %>" class="btn-editar">Editar</a>
            
            <form method="POST" action="/pedidos/excluir/<%= p.pedidoId %>" onsubmit="return confirm('Excluir o pedido #<%= p.pedidoId %>?');" style="margin: 0;">
              <button type="submit" class="btn-excluir">Excluir</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>