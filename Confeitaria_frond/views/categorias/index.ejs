<%- include('../partials/header') %>

<div class="page-header">
  <h2>Categorias</h2>
  <a href="/categorias/novo" class="btn-primary">+ Nova categoria</a>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Descrição</th>
      <th>&nbsp;</th>
    </tr>
  </thead>
  <tbody>
    <% if (lista.length === 0) { %>
      <tr><td colspan="4" style="padding: 10px;">Nenhuma categoria cadastrada.</td></tr>
    <% } %>
    
    <% lista.forEach(c => { %>
      <tr style="border-bottom: 1px solid #eee;">
        <td><%= c.categoriaId %></td>
        <td><%= c.categoriaNome %></td>
        <td><%= c.categoriaDescricao || '—' %></td>
        
        <td>
          <div class="acoes">
            <a href="/categorias/editar/<%= c.categoriaId %>" class="btn-editar">Editar</a>
            
            <form method="POST" action="/categorias/excluir/<%= c.categoriaId %>" onsubmit="return confirm('Excluir a categoria <%= c.categoriaNome %>?');" style="margin: 0;">
              <button type="submit" class="btn-excluir">Excluir</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>