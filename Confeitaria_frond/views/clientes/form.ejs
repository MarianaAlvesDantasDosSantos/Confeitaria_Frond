<%- include('../partials/header') %>

<div style="max-width: 1100px; margin: 0 auto;">
  <h2><%= item ? 'Editar cliente' : 'Novo cliente' %></h2>

  <form method="POST" action="<%= item ? '/clientes/editar/' + item.clienteId : '/clientes/novo' %>" class="card-form">
    
    <label for="clienteNome">Nome *</label>
    <input type="text" id="clienteNome" name="clienteNome" required maxlength="120"
           value="<%= item ? item.clienteNome : '' %>">

    <label for="clienteEmail">E-mail *</label>
    <input type="email" id="clienteEmail" name="clienteEmail" required maxlength="120"
           value="<%= item ? item.clienteEmail : '' %>">

    <label for="clienteCpf">CPF *</label>
    <input type="text" id="clienteCpf" name="clienteCpf" required maxlength="14"
           value="<%= item ? item.clienteCpf : '' %>">

    <label for="clienteTelefone">Telefone</label>
    <input type="text" id="clienteTelefone" name="clienteTelefone" maxlength="20"
           value="<%= item && item.clienteTelefone ? item.clienteTelefone : '' %>">

    <label for="clienteDataCadastro">Data de Cadastro *</label>
    <input type="datetime-local" id="clienteDataCadastro" name="clienteDataCadastro" required
           value="<%= item
              ? new Date(item.clienteDataCadastro).toISOString().slice(0, 16)
              : new Date().toISOString().slice(0, 16) %>">

    <div class="form-buttons">
      <button type="submit" class="btn-salvar">Salvar</button>
      <a href="/clientes" class="btn-cancelar">Cancelar</a>
    </div>
    
  </form>
</div>

<%- include('../partials/footer') %>