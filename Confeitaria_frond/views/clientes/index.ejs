<%- include('../partials/header') %>

<div class="page-header">
  <h2>Clientes</h2>
  <a href="/clientes/novo" class="btn-primary">+ Novo cliente</a>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>E-mail</th>
      <th>CPF</th>
      <th>Telefone</th>
      <th>&nbsp;</th> <!-- O espaço invisível garante que a coluna exista -->
    </tr>
  </thead>
  <tbody>
    <!-- ... o resto da sua tabela ... -->
    <% if (lista.length === 0) { %>
      <tr><td colspan="6" style="padding: 10px;">Nenhum cliente cadastrado.</td></tr>
    <% } %>
    
    <% lista.forEach(c => { %>
      <tr style="border-bottom: 1px solid #eee;">
        <td><%= c.clienteId %></td>
        <td><%= c.clienteNome %></td>
        <td><%= c.clienteEmail %></td>
        <td><%= c.clienteCpf %></td>
        <td><%= c.clienteTelefone || '—' %></td>
        
        <!-- AQUI ESTÁ A CORREÇÃO: Usando classes em vez de style="" -->
        <td>
          <div class="acoes">
            <a href="/clientes/editar/<%= c.clienteId %>" class="btn-editar">Editar</a>
            
            <form method="POST" action="/clientes/excluir/<%= c.clienteId %>" onsubmit="return confirm('Excluir o cliente <%= c.clienteNome %>?');" style="margin: 0;">
              <button type="submit" class="btn-excluir">Excluir</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>